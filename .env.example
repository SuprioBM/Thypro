# Optional. Everything works without any of these.

# Google Apps Script endpoint that receives pilot-access requests from the marketing page.
# VITE_SHEET_ENDPOINT=

# Optional language layer (translation of a person's own check-in note only).
# AI never creates plan content or touches the safety rules. If unset or failing, the
# original wording is saved and approved fixed templates are used.
# Contract: POST { text, source, target } -> { translation: string }
# VITE_LANGUAGE_API_URL=

# Never put secrets in VITE_* variables: they are bundled into the public site.
